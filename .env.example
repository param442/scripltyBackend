# PostgreSQL (Neon, Supabase, Railway, etc.)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Must match your frontend URL (auth is proxied through the frontend on Vercel)
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=generate-a-long-random-string

# CORS + OAuth trusted origin (your Vite frontend)
CLIENT_ORIGIN=http://localhost:5173

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Local dev server port
PORT=5000

# Production (set in Vercel dashboard):
# BETTER_AUTH_URL=https://scriplty.vercel.app
# CLIENT_ORIGIN=https://scriplty.vercel.app
